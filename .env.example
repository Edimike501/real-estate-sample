# ==============================================================================
# AURA LUXURY PROPERTIES — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# SQLite local database connection URL (default zero-config local setup)
DATABASE_URL="file:./dev.db"

# NextAuth secret key used for signing & encrypting JWT tokens
NEXTAUTH_SECRET="aura-luxury-portfolio-secret-key-2026"

# NextAuth base URL
NEXTAUTH_URL="http://localhost:3000"

# Public application base URL (used for sitemaps, openGraph metadata, and links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public WhatsApp contact number for property inquiry buttons
NEXT_PUBLIC_WHATSAPP_NUMBER="+2347000000000"


# ------------------------------------------------------------------------------
# 2. MEDIA STORAGE — CLOUDINARY (OPTIONAL)
# If omitted, the application automatically falls back to local disk storage in /public/uploads/
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS — RESEND (OPTIONAL)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
ADMIN_EMAIL="admin@auraluxury.com"


# ------------------------------------------------------------------------------
# 4. SEO & ANALYTICS (OPTIONAL)
# ------------------------------------------------------------------------------
INDEXNOW_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_YANDEX_METRICA_ID=""
